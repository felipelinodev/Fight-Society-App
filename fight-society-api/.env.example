# ============================================
# API - Environment Variables Example
# ============================================

# App Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME="Martial Arts Academy API"

# Database (PostgreSQL / Neon / Supabase / etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication
JWT_SECRET=your-strong-jwt-secret-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=7d

# Asaas Payment Gateway
# ASAAS_ENV: sandbox (https://sandbox.asaas.com) or production (https://www.asaas.com)
ASAAS_ENV=sandbox
ASAAS_API_KEY=your_asaas_api_key
# Any long random string; paste the same value as the webhook auth token in the Asaas panel
ASAAS_WEBHOOK_TOKEN=your_webhook_token

# CORS
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3001

# Optional Seed Defaults
ADMIN_EMAIL=admin@martialarts.com
ADMIN_PASSWORD=admin123
