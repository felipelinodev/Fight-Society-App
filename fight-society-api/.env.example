# ============================================
# API - Environment Variables Example
# ============================================

# App Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME="Martial Arts Academy API"

# Database (PostgreSQL / Neon / Supabase / etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication
JWT_SECRET=your-strong-jwt-secret-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3001

# Optional Seed Defaults
ADMIN_EMAIL=admin@martialarts.com
ADMIN_PASSWORD=admin123
